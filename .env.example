# Is file ko copy karke `.env` banao:   cp .env.example .env     (Windows: copy .env.example .env)
# Phir neeche ki values bharo. `.env` ko KABHI GitHub par mat daalo (.gitignore mein hai).

# ---- Zaroori ----
# Secret key banane ke liye terminal mein chalao:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---- AI model (LLM) ----
# Provider chuno: groq (default) | anthropic | openai_compatible
LLM_PROVIDER=groq

# Groq key: https://console.groq.com  ->  API Keys
GROQ_API_KEY=

# Model badalna ho to (khali = default: groq par openai/gpt-oss-20b, anthropic par claude-sonnet-5-5)
# Groq par doosre model ID ke liye Groq ke "models" docs dekho, jaise llama-3.1-8b-instant
LLM_MODEL=

# Sirf agar LLM_PROVIDER=anthropic ho:
ANTHROPIC_API_KEY=

# Sirf agar LLM_PROVIDER=openai_compatible ho (Ollama, Gemini, OpenRouter...). Examples:
#   Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=llama3.2   (LLM_API_KEY khali chhodo)
#   Gemini:          LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   + apni key LLM_API_KEY mein
LLM_BASE_URL=
LLM_API_KEY=

# ---- Database (sirf Docker Compose mein PostgreSQL ke liye) ----
# Password mein @ : / # jaise special characters mat rakho (URL toot jata hai)
POSTGRES_USER=docchat
POSTGRES_PASSWORD=
POSTGRES_DB=docchat

# ---- Optional ----
# Frontend ka address (comma se kai de sakte ho)
CORS_ORIGINS=http://localhost:3000
# Backend ka address, browser ke nazariye se
API_BASE_URL=http://localhost:8000
